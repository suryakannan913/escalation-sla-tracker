# Do not put real secrets in source control. Copy to .env and set values locally.
REFLEX_BASE_URL=https://reflex.runloop.ai
# Reflex accepts an organization ID OR its slug. The supplied workspace URL implies this slug.
REFLEX_ORGANIZATION_ID=surya-workspace
REFLEX_API_KEY=
# Optional: used only for a future Devbox log-polling fallback.
RUNLOOP_API_KEY=
SLACK_WEBHOOK_URL=
